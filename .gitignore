# Recycler login credentials generated by ml/provision_recyclers.py --
# never commit real (even if fictional-facility) account passwords.
recycler_credentials.json
ml/recycler_credentials.json

# Python venv for the ML pipeline
ml/.venv/

# Generated/synthetic training images (large, regeneratable via
# ml/generate_seed_images.py)
ml/seed_dataset/

# Synthetic multi-item composite training images (regeneratable via
# ml/generate_detection_dataset.py) and training run outputs (metrics,
# preview images -- regeneratable via ml/train_classifier.py /
# ml/train_detector.py).
ml/detection_dataset/
ml/artifacts/

# Built APKs are large binaries and fully regeneratable from source -- keep
# releases/CHANGELOG.md tracked, but not the .apk files themselves.
releases/**/*.apk

# macOS
.DS_Store

# Android build artifacts outside the standard Flutter build/ dir
app/android/build/

# Python bytecode cache
__pycache__/
*.pyc
